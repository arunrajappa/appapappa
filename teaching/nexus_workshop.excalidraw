      "seed": 1541676646,
      "version": 647,
      "versionNonce": 1108599779,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1746083782307,
      "link": null,
      "locked": false,
      "text": "CONTEXT: I am a public speaking Guru\nwith 20+ years experience in coaching\npeople how to speak up confidently\n\nObjective: I want do get a detailed\nwebinar plan for my 45 minute webinar\n\"Speak up! Get that frog out of your\nthroat!\"\n\nStyle: It shoudl be engaging and fun\n\nTone: I am an expert, so I want to sound\nlike an expert and not too casual\n\nAudience: The audience is teenage boys in\nthe age group 14-16\n\nResponse: Give me a detailed 2 page plan\nas a PDF. First show me this plan in\nCanvas.\n\nMake sure this is exactly a 45 minute plan.\nPlease check your timings again.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "JvX6bMPXe2uZjOvp3P1z6",
      "originalText": "CONTEXT: I am a public speaking Guru with 20+ years experience in coaching people how to speak up confidently\n\nObjective: I want do get a detailed webinar plan for my 45 minute webinar \"Speak up! Get that frog out of your throat!\"\n\nStyle: It shoudl be engaging and fun\n\nTone: I am an expert, so I want to sound like an expert and not too casual\n\nAudience: The audience is teenage boys in the age group 14-16\n\nResponse: Give me a detailed 2 page plan as a PDF. First show me this plan in Canvas.\n\nMake sure this is exactly a 45 minute plan. Please check your timings again.",
      "autoResize": true,
      "lineHeight": 1.25
    },
